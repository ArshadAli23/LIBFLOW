# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node modules & dependencies
node_modules/
*/node_modules/

# Build outputs & caches
dist/
dist-ssr/
build/
out/
.cache/
.turbo/

# Environment Variables & Secrets (Strict Exclusions)
.env
.env.*
!.env.example
!.env.*.example
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
*.local
*.env.local
*.env.*.local
*.env.production
*.env.staging

# Certificates, Keys & Credentials
*.pem
*.key
*.cert
*.crt
*.cer
*.pfx
*.p12
credentials.json
id_rsa*
id_ed25519*
secrets.*

# Database dumps and local database files (Preserving src migrations)
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz

# Test & Coverage reports
coverage/
.nyc_output/

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*.tmp
*.temp

# Temporary directories
temp/
tmp/

