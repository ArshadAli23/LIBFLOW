# LIBFLOW Backend Service Environment Configuration

# Application Environment (development, test, production)
NODE_ENV=development

# Server Port
PORT=5000

# API Versioning Prefix
API_PREFIX=/api/v1

# Allowed CORS Origins (comma-separated or single domain)
# In production, specify your exact domain (e.g. https://libflow.yourdomain.edu)
CORS_ORIGIN=http://localhost:5173

# Frontend Application Base URL
CLIENT_URL=http://localhost:5173

# Request Body Size Limit
REQUEST_LIMIT=1mb

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Database Configuration (MySQL 8+)
DB_HOST=localhost
DB_PORT=3306
DB_USER=libflow_user
DB_PASSWORD=your_secure_password
DB_NAME=libflow_db
DB_CONNECTION_LIMIT=10

# Authentication & Session Security (Phase 17.3)
SESSION_COOKIE_NAME=libflow_session
SESSION_TTL_HOURS=168
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

