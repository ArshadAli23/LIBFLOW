# LIBFLOW — Environment Variables Template
# 
# SECURITY NOTICE:
# - Do not commit live credentials, API keys, or production secrets to version control.
# - Copy this file to '.env.local' for local development configuration.

# Application Environment Mode ('development' | 'staging' | 'production')
VITE_APP_ENV=development

# Future Backend API Gateway Base URL (Phase 16 integration)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Institutional Tenant Identity
VITE_DEFAULT_TENANT_ID=tenant_central

# Feature Flags
VITE_ENABLE_MOCK_AUTH=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_BARCODE_SCANNER=true
